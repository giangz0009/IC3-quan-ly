  "questions": [
    {
      "id": "q_sb_lv1_gm2_01",
      "module": "computing_fundamentals",
      "level": "LV1",
      "category": "GM",
      "contentCode": "GM2",
      "topicOrder": 1,
      "topic": "Quản lý tệp tin",
      "type": "true_false",
      "prompt": "Xác định tính Đúng hoặc Sai của các phát biểu về thao tác tệp tin trên Windows:",
      "instruction": "Đánh dấu Đúng hoặc Sai cho từng ý.",
      "difficulty": "medium",
      "payload": {
        "statements": [
          {
            "id": "s1",
            "text": "Nhấn Delete trên bàn phím sẽ đưa tệp vào Recycle Bin (thùng rác).",
            "isTrue": true
          },
          {
            "id": "s2",
            "text": "Nhấn Shift + Delete sẽ xóa vĩnh viễn tệp mà không qua Recycle Bin.",
            "isTrue": true
          },
          {
            "id": "s3",
            "text": "Hai tệp cùng tên và cùng phần mở rộng có thể nằm chung trong một thư mục.",
            "isTrue": false
          }
        ]
      },
      "explanation": "Shift + Delete xóa thẳng không qua thùng rác; trong cùng 1 thư mục không thể có 2 tệp trùng tên và trùng phần mở rộng.",
      "createdAt": "2026-11-19T05:59:08.819476+00:00",
      "updatedAt": "2026-11-19T05:59:08.819476+00:00"
    },
    {
      "id": "q_sb_lv1_gm3_01",
      "module": "computing_fundamentals",
      "level": "LV1",
      "category": "GM",
      "contentCode": "GM3",
      "topicOrder": 1,
      "topic": "Sao lưu & Bảo trì",
      "type": "true_false",
      "prompt": "Đánh giá tính Đúng hoặc Sai của các nhận định sau về sao lưu dữ liệu (Backup):",
      "instruction": "Chọn Đúng hoặc Sai cho từng phát biểu.",
      "difficulty": "medium",
      "payload": {
        "statements": [
          {
            "id": "st_1",
            "text": "Sao lưu lên dịch vụ đám mây (OneDrive/Google Drive) giúp khôi phục tệp khi ổ cứng hỏng.",
            "isTrue": true
          },
          {
            "id": "st_2",
            "text": "Chỉ cần sao lưu tệp vào cùng một phân vùng ổ C để đảm bảo an toàn khi hỏng ổ cứng.",
            "isTrue": false
          },
          {
            "id": "st_3",
            "text": "Nên áp dụng quy tắc sao lưu định kỳ và lưu ít nhất một bản ở thiết bị/nơi tách biệt.",
            "isTrue": true
          }
        ]
      },
      "explanation": "Bản sao lưu phải nằm ở thiết bị khác hoặc trên đám mây; nếu để chung ổ cứng vật lý thì khi ổ hỏng sẽ mất cả bản chính lẫn bản sao.",
      "createdAt": "2026-11-19T02:14:53.685717+00:00",
      "updatedAt": "2026-11-19T05:41:36.846085+00:00"
    },
    {
      "id": "q_sb_lv1_gm3_02",
      "module": "computing_fundamentals",
      "level": "LV1",
      "category": "GM",
      "contentCode": "GM3",
      "topicOrder": 2,
      "topic": "Sao lưu dữ liệu",
      "type": "multiple",
      "prompt": "Những phương án nào sau đây giúp sao lưu (Backup) tệp tin an toàn khi ổ cứng máy tính bị hỏng?",
      "instruction": "Chọn TẤT CẢ đáp án đúng.",
      "difficulty": "medium",
      "payload": {
        "options": [
          {
            "id": "opt_1",
            "text": "Lưu đồng bộ lên OneDrive hoặc Google Drive"
          },
          {
            "id": "opt_2",
            "text": "Sao chép ra ổ cứng gắn ngoài (External HDD/SSD)"
          },
          {
            "id": "opt_3",
            "text": "Tạo thêm một thư mục cùng tên trên ổ C:"
          },
          {
            "id": "opt_4",
            "text": "Sao lưu sang USB lưu trữ rời"
          }
        ],
        "correctOptionIds": [
          "opt_1",
          "opt_2",
          "opt_4"
        ]
      },
      "explanation": "Sao lưu an toàn phải nằm trên thiết bị vật lý khác hoặc dịch vụ đám mây, không nằm chung ổ cứng đang dùng.",
      "tips": "Tránh lưu bản sao dự phòng trên cùng phân vùng ổ C:.",
      "createdAt": "2026-11-19T02:14:53.685717+00:00",
      "updatedAt": "2026-11-19T02:18:28.477569+00:00"
    },
